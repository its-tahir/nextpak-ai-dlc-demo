{
  "permissions": {
    "deny": [
      "mcp__next-sprint__delete_task",
      "mcp__next-sprint__delete_comment",
      "mcp__next-sprint__delete_checklist",
      "mcp__next-sprint__delete_checklist_item",
      "mcp__next-sprint__delete_list",
      "mcp__next-sprint__delete_task_attachment",
      "mcp__next-sprint__remove_board_member",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./.env.production)",
      "Read(./.env.prod)",
      "Read(./.env.staging)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(./dbhub.toml)",
      "Edit(./.guardrails/**)",
      "Edit(./.claude/settings.json)",
      "Edit(./.mcp.json)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git commit --no-verify:*)",
      "Bash(npm publish:*)",
      "Bash(gh pr merge:*)",
      "Bash(printenv:*)"
    ],
    "allow": [
      "Bash(npm test:*)",
      "Bash(npm run test:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run typecheck:*)",
      "Bash(npm run build:*)",
      "Bash(npx tsc --noEmit:*)",
      "Bash(pytest:*)",
      "Bash(ruff check:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(git rebase:*)",
      "Bash(gh pr create:*)",
      "Bash(vercel:*)",
      "Bash(docker compose down:*)",
      "Bash(curl:*)",
      "Bash(wget:*)"
    ],
    "disableBypassPermissionsMode": "disable"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Edit|Write|MultiEdit|NotebookEdit|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.guardrails/agent-guard.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
